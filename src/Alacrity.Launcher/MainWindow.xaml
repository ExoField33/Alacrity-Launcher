<Window x:Class="Alacrity.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Alacrity Launcher"
        Icon="pack://application:,,,/Alacrity_Launcher.ico"
        Width="640"
        Height="440"
        MinWidth="520"
        MinHeight="360"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="16" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="8" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="12" />
      <RowDefinition Height="*" />
      <RowDefinition Height="12" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <DockPanel Grid.Row="0">
      <TextBlock Text="Alacrity Launcher" FontSize="22" FontWeight="SemiBold" DockPanel.Dock="Left" />
    </DockPanel>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>
      <ComboBox Grid.Column="0"
                Height="34"
                ItemsSource="{Binding Versions}"
                SelectedItem="{Binding SelectedVersion}"
                DisplayMemberPath="DisplayName" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="12,0,0,0">
        <Button Content="Launch" Click="Launch_Click" IsEnabled="{Binding CanLaunchSelected}" />
        <Button Content="Download" Click="Download_Click" IsEnabled="{Binding CanDownloadSelected}" />
        <Button Content="Refresh" Click="Refresh_Click" IsEnabled="{Binding IsIdle}" Margin="0" />
      </StackPanel>
    </Grid>

    <Grid Grid.Row="4">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Text="Terraria folder" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Margin="0,0,8,0" />
      <TextBox Grid.Column="1" Text="{Binding TerrariaDirectory, UpdateSourceTrigger=PropertyChanged}" />
    </Grid>

    <Grid Grid.Row="6">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="8" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <DockPanel Grid.Row="0" LastChildFill="False">
        <TextBlock Text="{Binding ChangelogHeading}" FontSize="14" FontWeight="SemiBold" DockPanel.Dock="Left" />
        <StackPanel x:Name="ChangelogSearchPanel" Orientation="Horizontal" Visibility="Collapsed" DockPanel.Dock="Right">
          <TextBox x:Name="ChangelogSearchBox"
                   Width="170"
                   VerticalContentAlignment="Center"
                   TextChanged="ChangelogSearchBox_TextChanged"
                   KeyDown="ChangelogSearchBox_KeyDown"
                   LostKeyboardFocus="ChangelogSearchBox_LostKeyboardFocus" />
          <Button Content="Next" Click="ChangelogSearchNext_Click" Margin="6,0,0,0" />
        </StackPanel>
      </DockPanel>
      <Border Grid.Row="2" Background="{StaticResource PanelBrush}" Padding="12">
        <TextBox x:Name="ChangelogTextBox"
                 Text="{Binding SelectedChangelog, Mode=OneWay}"
                 IsReadOnly="True"
                 IsInactiveSelectionHighlightEnabled="True"
                 BorderThickness="0"
                 Background="Transparent"
                 Foreground="{StaticResource TextBrush}"
                 FontFamily="Consolas"
                 FontSize="15"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Disabled" />
      </Border>
    </Grid>

    <TextBlock Grid.Row="8" Text="{Binding Status}" Foreground="{StaticResource MutedTextBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
  </Grid>
</Window>
