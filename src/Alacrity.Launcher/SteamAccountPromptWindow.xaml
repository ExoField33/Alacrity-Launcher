<Window x:Class="Alacrity.Launcher.SteamAccountPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Steam sign-in"
        Width="420"
        Height="205"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}">
  <Grid Margin="20">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="10" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <TextBlock Grid.Row="0" x:Name="PromptText" TextWrapping="Wrap" Foreground="{StaticResource MutedTextBrush}" />
    <TextBox Grid.Row="2" x:Name="AccountNameTextBox" Height="30" />
    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" Click="Cancel_Click" />
      <Button Content="Continue" Margin="0" Click="Continue_Click" />
    </StackPanel>
  </Grid>
</Window>
